# Contact form: get your Form ID from formspree.io
# 1. Create account, add form with varveroglouvas@gmail.com
# 2. Copy the form ID from the endpoint URL (e.g. mnopqrst from formspree.io/f/mnopqrst)
VITE_FORMSPREE_ID=

# Optional: cookieless analytics (plausible.io). Set to your domain, e.g. example.gr
VITE_PLAUSIBLE_DOMAIN=
# Optional: public site URL once you have a custom domain (used for canonical, hreflang, sitemap)
VITE_SITE_URL=
